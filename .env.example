OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: SearXNG base URL for self-hosted private search (recommended).
# Start with: docker run -d -p 8080:8080 searxng/searxng
# Aggregates Google, Bing, DuckDuckGo, Wikipedia — no rate limits, no logging.
# When set, SearXNG is used as primary search backend (Tavily → DDG as fallback).
SEARXNG_BASE_URL=

# Optional: Tavily API key (https://tavily.com — free tier ~1000 searches/mo).
# When set (and SearXNG not configured), current-facts queries use Tavily's
# clean, recency-ranked, pre-extracted results instead of DuckDuckGo scraping.
TAVILY_API_KEY=

# Optional: premium fallback model for MCP escalation.
# When set, escalated tasks are handled by this model (e.g. claude-opus-4-8).
# Leave empty to let the calling AI (Claude Code, Copilot, etc.) handle escalation.
FALLBACK_MODEL=

# Confidence threshold below which escalation is triggered (0.0-1.0)
ESCALATION_THRESHOLD=0.70

# Max local retries before escalation is offered
MAX_LOCAL_RETRIES=2
