OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Tavily API key (https://tavily.com — free tier ~1000 searches/mo).
# When set, "current facts" queries (latest version, news, prices) use Tavily's
# clean, recency-ranked, pre-extracted results instead of DuckDuckGo scraping.
TAVILY_API_KEY=

# Confidence threshold below which escalation is triggered (0.0-1.0)
ESCALATION_THRESHOLD=0.70

# Max local retries before escalation is offered
MAX_LOCAL_RETRIES=2
